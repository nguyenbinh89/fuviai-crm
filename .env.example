# ===========================
# FuviAI CRM — Environment Variables
# Copy to .env and fill in values
# ===========================

# --- Database ---
DATABASE_URL="postgresql://fuviai:fuviai_password@localhost:5432/fuviai_crm?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT Auth ---
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# --- API ---
API_PORT=4000
API_PREFIX="api/v1"
NODE_ENV="development"

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-nextauth-secret"

# --- OpenAI ---
OPENAI_API_KEY="sk-..."

# --- Email (MailHog local / AWS SES production) ---
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@fuviai.com"

# --- Zalo OA ---
ZALO_OA_ID=""
ZALO_OA_SECRET=""

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- VNPay ---
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# --- AWS ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"
AWS_SES_FROM_EMAIL="noreply@fuviai.com"
